{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDineFlowAvatarBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::dineflow-avatars-prod"
    },
    {
      "Sid": "ReadWriteDineFlowAvatarObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::dineflow-avatars-prod/*"
    }
  ]
}
