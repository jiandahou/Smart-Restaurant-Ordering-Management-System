# ==========================================================================
# DineFlow PRODUCTION env (EC2). Copy to `.env.prod` and fill in real values.
#   cp .env.prod.example .env.prod
# NEVER commit .env.prod. Generate strong secrets (see README-EC2.md).
# ==========================================================================

# --- Database (dockerized Postgres on the instance) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Seed platform owner (first login). CHANGE THE PASSWORD. ---
SEED_OWNER_EMAIL=owner@dineflow.com
SEED_OWNER_PASSWORD=CHANGE_ME_strong_owner_password
SEED_OWNER_FULL_NAME=DineFlow Owner

# --- JWT (must be >= 32 chars; generate with: openssl rand -base64 48) ---
JWT_ISSUER=DineFlow.Api
JWT_AUDIENCE=DineFlow.Client
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_base64_48
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=90

# --- Public URLs (behind Cloudflare Tunnel) ---
FRONTEND_BASE_URL=https://control-dineflow.theunknownfish.com
VITE_PUBLIC_APP_BASE_URL=https://demo-dineflow.theunknownfish.com
CORS_ALLOWED_ORIGINS=https://demo-dineflow.theunknownfish.com,https://control-dineflow.theunknownfish.com

# --- Demo auto-login (build-time) ---
# "true" pre-fills the seeded owner on the login page (showcase/demo behaviour,
# as the current stage site does). Set "false" for a real production site.
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_SEED_PASSWORD=

# --- Passkeys (WebAuthn) ---
PASSKEY_SERVER_DOMAIN=control-dineflow.theunknownfish.com
PASSKEY_SERVER_NAME=DineFlow
PASSKEY_ORIGINS=https://control-dineflow.theunknownfish.com

# --- Email (Resend) ---
AUTH_EMAIL_FROM=noreply@theunknownfish.com
EMAIL_SERVER=smtps://resend:REPLACE@smtp.resend.com:465
RESEND_API_KEY=REPLACE_with_resend_api_key

# --- OAuth (optional; leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_PATH=/api/auth/google/signin

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_REPLACE
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_CURRENCY=aud
STRIPE_SUCCESS_URL=https://demo-dineflow.theunknownfish.com/payment/success
STRIPE_CANCEL_URL=https://demo-dineflow.theunknownfish.com/payment/cancelled
STRIPE_CONNECT_RETURN_URL=https://control-dineflow.theunknownfish.com/admin/restaurants?stripeConnect=return
STRIPE_CONNECT_REFRESH_URL=https://control-dineflow.theunknownfish.com/admin/restaurants?stripeConnect=refresh
STRIPE_PLATFORM_FEE_SUCCESS_URL=https://control-dineflow.theunknownfish.com/admin/restaurants?platformFee=success
STRIPE_PLATFORM_FEE_CANCEL_URL=https://control-dineflow.theunknownfish.com/admin/restaurants?platformFee=cancelled

# --- Avatar/file storage: real AWS S3 ---
# Create a bucket + an IAM user with s3:PutObject/GetObject/DeleteObject on it.
AVATAR_STORAGE_BUCKET=dineflow-avatars-prod
AVATAR_STORAGE_REGION=ap-southeast-2
# Standard AWS endpoint: leave ServiceUrl blank and ForcePathStyle=false.
AVATAR_STORAGE_SERVICE_URL=
AVATAR_STORAGE_FORCE_PATH_STYLE=false
# Public read URL for objects. Simplest: enable bucket public-read (or a CloudFront
# distribution) and point here. Path style shown for the plain S3 endpoint:
AVATAR_STORAGE_UPLOAD_BASE_URL=https://dineflow-avatars-prod.s3.ap-southeast-2.amazonaws.com
AVATAR_STORAGE_PUBLIC_BASE_URL=https://dineflow-avatars-prod.s3.ap-southeast-2.amazonaws.com
AWS_ACCESS_KEY_ID=REPLACE_iam_access_key
AWS_SECRET_ACCESS_KEY=REPLACE_iam_secret_key

# --- QZ Tray printing (optional; base64-encoded PEMs) ---
QZ_PRIVATE_KEY_PEM_B64=
QZ_CERT_PEM_B64=
