POSTGRES_PASSWORD=dineflow_password

SEED_OWNER_EMAIL=owner@dineflow.com
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_OWNER_FULL_NAME=DineFlow Owner

# Startup behaviour. Both are ignored in Production: migrations run as a release task
# (`dotnet DineFlow.Api.dll --migrate`) and demo data is never seeded there.
DATABASE_MIGRATE_ON_STARTUP=true
SEED_DEMO_DATA=true

# Sign-in form autofill, development server only — a production build drops these strings from the
# bundle entirely. Set VITE_DEMO_LOGIN=off to start from empty fields locally.
VITE_DEMO_LOGIN=on
VITE_DEMO_LOGIN_EMAIL=owner@dineflow.com
VITE_DEMO_LOGIN_PASSWORD=ChangeMe123!

JWT_ISSUER=DineFlow.Api
JWT_AUDIENCE=DineFlow.Client
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=90

EMAIL_FROM=noreply@example.com
AUTH_EMAIL_FROM=noreply@example.com
EMAIL_SERVER=smtps://resend:replace-with-resend-api-key@smtp.resend.com:465
RESEND_API_KEY=replace-with-resend-api-key
FRONTEND_BASE_URL=http://localhost:5173
# The frontend calls the API with relative /api paths on its own origin. Locally the Vite dev
# server proxies them to VITE_API_PROXY_TARGET; in production CloudFront forwards /api/* to the
# backend. There is deliberately no API base URL variable — see docs/deployment/aws-staging.md.
VITE_API_PROXY_TARGET=http://localhost:5000
# Development-only same-origin proxy for local MinIO images. Docker Compose overrides this with
# http://minio:9000 so phones opening Vite over the LAN do not request their own localhost:9000.
VITE_ASSET_PROXY_TARGET=http://localhost:9000
VITE_PRINTER_BRIDGE_URL=http://127.0.0.1:17891

# Mandatory in production. Use the real platform legal entity and matching frontend values.
Compliance__OperatorName=
Compliance__OperatorAbn=
Compliance__OperatorAddress=
Compliance__PrivacyEmail=
Compliance__SupportEmail=
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_OPERATOR_ABN=
VITE_LEGAL_OPERATOR_ADDRESS=
VITE_LEGAL_PRIVACY_EMAIL=
VITE_LEGAL_SUPPORT_EMAIL=

# Production startup is blocked until the separately credentialed report-retention job, archive,
# legal-hold register and a restore drill from the last 12 months are all recorded here. The web
# runtime role stays append-only and must not receive the maintenance role's credentials.
ReportRetention__ExternalMaintenanceEnabled=false
ReportRetention__ScheduledJobReference=
ReportRetention__ArchiveDestination=
ReportRetention__LegalHoldRegister=
ReportRetention__LastRestoreDrillUtc=

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_PATH=/api/auth/google/signin

FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
FACEBOOK_CALLBACK_PATH=/api/auth/facebook/signin

PASSKEY_SERVER_DOMAIN=localhost
PASSKEY_SERVER_NAME=DineFlow
PASSKEY_ORIGINS=http://localhost:5173

STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace-with-connect-webhook-secret
STRIPE_FORWARD_TO_URL=http://localhost:5000/api/payments/stripe/webhook
STRIPE_CURRENCY=aud
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancelled
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/admin/restaurants?stripeConnect=return
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/admin/restaurants?stripeConnect=refresh
STRIPE_PLATFORM_FEE_SUCCESS_URL=http://localhost:5173/admin/restaurants?platformFee=success
STRIPE_PLATFORM_FEE_CANCEL_URL=http://localhost:5173/admin/restaurants?platformFee=cancelled

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173

AVATAR_STORAGE_PROVIDER=S3
AVATAR_STORAGE_BUCKET=dineflow-avatars-local
AVATAR_STORAGE_REGION=ap-southeast-2
AVATAR_STORAGE_SERVICE_URL=http://minio:9000
AVATAR_STORAGE_UPLOAD_BASE_URL=http://localhost:9000
AVATAR_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/dineflow-avatars-local
AVATAR_STORAGE_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# QZ Tray request signing (base64-encoded PEMs; generate with:
#   openssl req -x509 -newkey rsa:2048 -keyout qz-private-key.pem -out qz-certificate.pem -days 3650 -nodes -subj "/CN=DineFlow QZ Signing"
#   then base64 -w0 each file). Leave empty to fall back to anonymous (prompting) QZ requests.
QZ_PRIVATE_KEY_PEM_B64=
QZ_CERT_PEM_B64=
